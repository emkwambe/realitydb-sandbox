# RealityDB SimLab — environment template. Copy to .env.local and fill in.
# Vite inlines these at build time (VITE_ prefix = exposed to client).

# Lab API Worker (public URL; key is a scoped lab key)
VITE_LAB_API_URL=https://realitydb-lab-api.eddy-078.workers.dev
VITE_LAB_API_KEY=

# Supabase auth (anon key is publishable)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
